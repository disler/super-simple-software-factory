# SSSF environment. Copy to .env at the target repo root and fill in.
#
# The starter roster uses the authenticated Claude Code and Codex CLIs, so it
# needs no API key here. Provider keys are only needed for Pi-backed agents;
# which keys you need then depends on the providers named in your roster and in
# ~/.pi/agent/models.json.

OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# CLAUDE_PATH=claude               # Claude Code binary if not on PATH
# CODEX_PATH=codex                 # Codex binary if not on PATH
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
